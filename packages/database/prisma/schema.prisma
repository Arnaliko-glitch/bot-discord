// Sortie personnalisée (au lieu du node_modules/.prisma/client par défaut) :
// un déploiement isolé (pnpm deploy, utilisé par le Dockerfile du bot) ne
// propage pas fiablement ce dossier "caché" dans node_modules — en le
// générant comme un fichier normal du package, il suit automatiquement
// n'importe quel mécanisme de copie/déploiement.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                  String                @id
  name                String
  icon                String?
  updatedAt           DateTime              @updatedAt
  LevelRole           LevelRole[]
  TemporaryRoleGrant  TemporaryRoleGrant[]
  LogsConfig          LogsConfig?
  PrivateRoom         PrivateRoom[]
  PrivateRoomConfig   PrivateRoomConfig?
  ReactionRolePanel   ReactionRolePanel[]
  SavedMessage        SavedMessage[]
  ServerTagConfig     ServerTagConfig?
  StatsChannel        StatsChannel[]
  Ticket              Ticket[]
  TicketConfig        TicketConfig?
  TicketRequest       TicketRequest[]
  UserXp              UserXp[]
  welcomeConfig       WelcomeConfig?
  WordReactionConfig  WordReactionConfig?
  WordReactionTrigger WordReactionTrigger[]
  XpSettings          XpSettings?
}

// Réagit automatiquement (emoji) quand un message commence par une phrase
// configurée, insensible à la casse — restrictions de rôles/salons
// globales au module (pas par déclencheur), façon DraftBot.
model WordReactionConfig {
  id          String   @id
  guildId     String   @unique
  enabled     Boolean  @default(false)
  // "allow" = seuls ces rôles/salons déclenchent une réaction ; "deny" =
  // tous sauf ceux-ci. Vide = tout le monde/partout, quel que soit le mode.
  roleMode    String   @default("allow")
  roleIds     String[] @default([])
  channelMode String   @default("allow")
  channelIds  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model WordReactionTrigger {
  id        String   @id
  guildId   String
  // Comparée au début du message (trim + minuscule) — "Salut" dans le
  // message correspond à "salut" configuré ici.
  phrase    String
  emojis    String[] @default([])
  createdAt DateTime @default(now())
  Guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model WelcomeConfig {
  id                       String   @id @default(cuid())
  guildId                  String   @unique
  enabled                  Boolean  @default(false)
  channelId                String?
  goodbyeChannelId         String?
  message                  String   @default("Bienvenue {user} sur **{server}** ! Tu es le membre n°{server.membercount}.")
  goodbyeMessage           String   @default("{user} a quitté **{server}**.")
  sidebarColor             String   @default("#dc2626")
  goodbyeSidebarColor      String   @default("#dc2626")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  mentionUser              Boolean  @default(true)
  backgroundColor          String   @default("#57F287")
  backgroundImage          String?
  goodbyeEnabled           Boolean  @default(false)
  goodbyeBackgroundColor   String   @default("#ED4245")
  goodbyeBackgroundImage   String?
  useEmbed                 Boolean  @default(true)
  embedTitle               String?
  embedFooter              String?
  goodbyeUseEmbed          Boolean  @default(true)
  goodbyeEmbedTitle        String?
  goodbyeEmbedFooter       String?
  backgroundOverlay        Boolean  @default(true)
  goodbyeBackgroundOverlay Boolean  @default(true)
  moduleEnabled            Boolean  @default(false)
  guild                    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model LevelRole {
  id              String   @id
  guildId         String
  level           Int
  roleId          String
  // "role" (permanent) | "temporary_role"
  rewardType      String   @default("role")
  // "stack" (cumulable) | "evolve" (remplace la précédente) — pertinent
  // seulement pour rewardType="role".
  stackMode       String   @default("stack")
  // Durée en secondes avant retrait automatique — seulement pour
  // rewardType="temporary_role" (1h/1j/1semaine/1mois proposés dans l'UI).
  durationSeconds Int?
  createdAt       DateTime @default(now())
  Guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, level])
}

// Un rôle temporaire (LevelRole.rewardType = "temporary_role") accordé à un
// membre — Discord n'a pas de retrait automatique natif, on suit donc
// nous-mêmes l'échéance pour la retirer via un balayage périodique du bot.
model TemporaryRoleGrant {
  id        String   @id
  guildId   String
  userId    String
  roleId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  Guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model SavedMessage {
  id                String   @id
  guildId           String
  name              String
  channelId         String?
  content           String?
  embedData         Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  lastSentChannelId String?
  lastSentMessageId String?
  buttons           Json?
  imageUrls         String[]  @default([])
  // Renvoie automatiquement ce message (nouveau message à chaque fois, pas
  // une édition) toutes les autoSendIntervalMin minutes — voir
  // apps/web/src/lib/auto-send-scheduler.ts. autoSendNextAt est recalculé
  // par le serveur (jamais depuis le dashboard) à chaque activation ou
  // changement d'intervalle.
  autoSendEnabled     Boolean   @default(false)
  autoSendIntervalMin Int?
  autoSendNextAt      DateTime?
  Guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model Ticket {
  id                   String    @id
  guildId              String
  channelId            String    @unique
  creatorId            String
  creatorName          String
  subject              String?
  status               String    @default("open")
  closedBy             String?
  closedAt             DateTime?
  closeReason          String?
  reopenedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  activeCloseMessageId String?
  // Demande de validation à l'origine de ce ticket (flux avec validation
  // activée) — absent si le ticket a été créé directement. Pas de relation
  // Prisma formelle : la TicketRequest liée est supprimée manuellement en
  // même temps que le ticket (voir deleteTicket dans ticketActions.ts).
  requestId            String?   @unique
  Guild                Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
}

model TicketConfig {
  id                  String   @id
  guildId             String   @unique
  enabled             Boolean  @default(false)
  categoryId          String?
  ticketNameFormat    String   @default("{user.globalname}")
  maxOpenPerUser      Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  accessRoleIds       String[] @default([])
  askCloseReason      Boolean  @default(true)
  askOpenReason       Boolean  @default(true)
  autoDeleteOnClose   Boolean  @default(false)
  confirmationMessage String   @default("Votre ticket a bien été envoyé, un membre du staff vous prendra rapidement en charge si votre ticket est accepté !")
  logChannelId        String?
  mentionModerators   Boolean  @default(true)
  moderatorRoleIds    String[] @default([])
  noReasonMessage     String   @default("N'hésitez pas à décrire votre problème, un membre du staff vous prendra rapidement en charge.")
  validationEnabled   Boolean  @default(true)
  // Message posté par le bot à l'ouverture du salon de ticket — version
  // texte simple en attendant le composeur de messages (avec boutons/embed).
  openingMessage      String   @default("Bonjour {user}, décrivez votre problème et un membre du staff vous répondra sous peu.")
  Guild               Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Salon vocal "hub" — rejoindre ce salon crée automatiquement un salon
// temporaire dont le créateur devient propriétaire (voir PrivateRoom), façon
// DraftBot. `categoryId` vide = crée dans la même catégorie que le hub.
model PrivateRoomConfig {
  id                       String   @id
  guildId                  String   @unique
  enabled                  Boolean  @default(false)
  hubChannelId             String?
  categoryId               String?
  nameTemplate             String   @default("🔊 Salon de {user}")
  // 0 = illimité, comme le "User Limit" natif d'un salon vocal Discord.
  userLimit                Int      @default(0)
  // "category" = le salon créé hérite des permissions de sa catégorie
  // (comportement Discord par défaut) ; "hub" = il copie plutôt les
  // permissions du salon de création lui-même.
  permissionSource         String   @default("category")
  // Permissions Discord données au créateur sur son propre salon (en plus
  // des droits qu'il a déjà par ses rôles) — voir applyCreatorPermissions
  // dans privateRooms.ts pour le détail de chaque flag.
  creatorCanInvite         Boolean  @default(true)
  creatorPrioritySpeaker   Boolean  @default(true)
  creatorSetStatus         Boolean  @default(true)
  creatorManageChannel     Boolean  @default(false)
  creatorUseSoundboard     Boolean  @default(true)
  creatorManagePermissions Boolean  @default(false)
  // Un membre encore présent peut réclamer la propriété d'un salon dont le
  // créateur est parti, via le bouton "Transfert" du menu.
  allowClaim               Boolean  @default(true)
  // Poste un message avec des boutons (Ouvrir/Fermer, Privé, Renommer,
  // Limite, Purge, Transfert, Liste blanche/noire) dans chaque salon créé.
  configMenuEnabled        Boolean  @default(true)
  // Rôles qui peuvent utiliser le menu sur N'IMPORTE QUEL salon temporaire,
  // pas seulement le leur.
  moderatorRoleIds         String[] @default([])
  // Rôles qui ne peuvent jamais être expulsés/mis en liste noire (Purge,
  // bouton Liste noire les ignorent).
  untouchableRoleIds       String[] @default([])
  // Rôles autorisés à rejoindre un salon par défaut (mode "ouvert") — vide
  // = tout le monde (@everyone), comme le reste du projet pour ce genre de liste.
  accessRoleIds            String[] @default([])
  createdAt                DateTime @default(now())
  updatedAt                DateTime
  Guild                    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Un salon vocal temporaire actuellement suivi — sert à savoir qui en est le
// propriétaire (permissions données à la création), son mode d'accès actuel,
// et à le supprimer dès qu'il se vide (y compris pour rattraper les
// orphelins si le bot a redémarré pendant qu'un salon existait).
model PrivateRoom {
  id               String   @id
  guildId          String
  channelId        String   @unique
  ownerId          String
  // "open" (rôles d'accès de base), "closed" (personne de nouveau ne peut
  // rejoindre), "private" (invisible pour les non-membres), "whitelist"
  // (seuls whitelistUserIds + le propriétaire), "blacklist" (tout le monde
  // sauf blacklistUserIds).
  mode             String   @default("open")
  whitelistUserIds String[] @default([])
  blacklistUserIds String[] @default([])
  createdAt        DateTime @default(now())
  Guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model TicketRequest {
  id                  String   @id
  guildId             String
  requesterId         String
  requesterName       String
  reason              String?
  status              String   @default("pending")
  createdAt           DateTime @default(now())
  validationChannelId String?
  validationMessageId String?
  denyReason          String?
  decidedBy           String?
  Guild               Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
}

model UserXp {
  id            String   @id
  guildId       String
  discordUserId String
  username      String
  // Pseudo de connexion Discord (ex: "jtefumesousweed"), distinct du pseudo
  // affiché ci-dessus — stocké séparément pour rester disponible dans le
  // classement même quand le membre n'est plus dans le cache du bot.
  handle        String?
  avatar        String?
  xp            Int      @default(0)
  level         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordUserId])
  @@index([guildId, xp])
}

model XpSettings {
  id                       String   @id
  guildId                  String   @unique
  enabled                  Boolean  @default(false)
  xpMin                    Int      @default(15)
  xpMax                    Int      @default(25)
  cooldownSeconds          Int      @default(30)
  levelUpChannelId         String?
  levelUpMessage           String   @default("{user}, vous venez de passer au niveau {level} !")
  ignoredChannelIds        String[] @default([])
  ignoredRoleIds           String[] @default([])
  createdAt                DateTime @default(now())
  updatedAt                DateTime
  boosterChannelIds        String[] @default([])
  boosterRoleIds           String[] @default([])
  curveMultiplier          Float    @default(1)
  curveStyle               String   @default("exponential")
  levelUpAnnounceMode      String   @default("channel")
  levelUpMinLevel          Int      @default(0)
  longMessageDoubleXp      Boolean  @default(false)
  maxLevel                 Int      @default(0)
  resetXpOnBan             Boolean  @default(false)
  resetXpOnLeave           Boolean  @default(true)
  rewardAnnounceMode       String   @default("channel")
  rewardChannelId          String?
  rewardMessage            String   @default("{user}, voici votre récompense pour avoir atteint le **niveau {reward.level}** !")
  viewOthersLevel          Boolean  @default(true)
  publicLeaderboardEnabled Boolean  @default(false)
  xpChannelMode            String   @default("without")
  xpInForumPosts           Boolean  @default(true)
  xpInThreads              Boolean  @default(true)
  xpRoleMode               String   @default("without")
  voiceTextXpMode          String   @default("everyone")
  voiceXpEnabled           Boolean  @default(false)
  voiceXpIntervalSeconds   Int      @default(60)
  voiceXpMax               Int      @default(15)
  voiceXpMin               Int      @default(5)
  Guild                    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Compteur journalier d'arrivées/départs — agrégé au jour plutôt qu'un
// évènement par membre, pour rester léger même après des mois d'historique.
// Alimenté par le bot (guildMemberAdd/Remove), lu par la page d'accueil du
// dashboard pour le graphique de variation nette des membres.
model DailyMemberStat {
  id        String   @id
  guildId   String
  // Clé du jour civil Europe/Paris encodée à 00:00Z (pas un instant).
  // Les anciens compteurs UTC doivent être reconstruits depuis des événements
  // horodatés : décaler cette colonne ne suffit pas à réaffecter les membres.
  date      DateTime
  joins     Int      @default(0)
  leaves    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([guildId, date])
  @@index([guildId, date])
}

// Rôle attribué automatiquement à un membre tant qu'il affiche le tag de ce
// serveur sur son profil Discord (fonctionnalité "identité de serveur"),
// retiré dès qu'il le retire.
model ServerTagConfig {
  id                String   @id
  guildId           String   @unique
  enabled           Boolean  @default(false)
  roleId            String?
  announceChannelId String?
  announceMessage   String   @default("{user}, voici votre récompense pour avoir mis le tag du serveur ! 🏷️")
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  Guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Salons de logs par catégorie d'événement — une seule catégorie pour
// l'instant (tag du serveur), les colonnes suivantes seront ajoutées au fur
// et à mesure des autres catégories (modération, tickets...).
model LogsConfig {
  id            String   @id
  guildId       String   @unique
  tagChannelId  String?
  tagLogAdded   Boolean  @default(true)
  tagLogRemoved Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// Un salon créé par le bot et renommé périodiquement pour afficher une
// statistique du serveur (ex: "Membres : 1234") — {count} dans `format` est
// remplacé par la valeur de `statType` à chaque mise à jour. Contrairement
// au reste du module Logs, le salon lui-même est créé/supprimé par le
// dashboard (pas juste sélectionné parmi des salons existants).
model StatsChannel {
  id          String   @id
  guildId     String
  channelId   String   @unique
  // "membersNoBots" | "membersTotal" — la liste des statistiques calculables
  // par le bot, amenée à s'étendre (voir packages/bot/src/modules/statsChannels.ts).
  statType    String
  // "voice" | "text" — un salon vocal créé ici est verrouillé (connexion
  // refusée à @everyone) puisqu'il ne sert qu'à afficher son nom.
  channelType String   @default("voice")
  format      String   @default("Membres : {count}")
  createdAt   DateTime @default(now())
  Guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// Un panneau "rôles-réactions" : un message (posté ou attaché à un message
// déjà envoyé) où réagir avec un emoji donné ajoute le rôle associé, et
// retirer la réaction le retire — pas de relation formelle vers les rôles
// Discord (juste des ids), comme le reste du projet qui ne duplique jamais
// les rôles/salons en base. `mappings` : [{ emoji, roleId }].
// `messageId` reste vide tant que le panneau n'a jamais été publié.
model ReactionRolePanel {
  id        String   @id
  guildId   String
  name      String
  channelId String?
  messageId String?  @unique
  // "normal" = ajoute le rôle à la réaction, le retire au retrait — seul
  // mode pour l'instant, gardé en colonne pour ajouter d'autres modes plus
  // tard sans nouvelle migration.
  mode      String   @default("normal")
  content   String?
  imageUrl  String?
  // Un seul embed (même forme que EmbedData/EmbedEditor.tsx, comme le
  // composeur de messages) — null tant que l'utilisateur n'a pas cliqué sur
  // l'onglet Embed, pas de valeurs par défaut déduites.
  embedData Json?
  mappings  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime
  Guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// Ligne unique mise à jour périodiquement par le process du bot (voir
// packages/bot/src/index.ts) — permet au dashboard (process web séparé) de
// savoir si le bot est réellement connecté à Discord, pas juste si le token
// est valide (le rond "Connecté" de la sidebar).
model BotHeartbeat {
  id        String   @id @default("singleton")
  updatedAt DateTime
}

// Session du dashboard conservée côté serveur. Le navigateur ne reçoit qu'un
// jeton aléatoire ; le jeton Discord OAuth reste dans PostgreSQL.
model DashboardSession {
  tokenHash   String   @id
  userId      String
  username    String
  globalName  String?
  avatar      String?
  accessToken String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}
