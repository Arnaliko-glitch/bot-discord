# Application Discord (portail développeur Discord) — Client ID/Secret de
# l'app OAuth, token du bot, et l'URL de callback OAuth exacte enregistrée
# côté Discord (doit correspondre pile, schéma + domaine + chemin).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=https://ton-domaine.example/api/auth/callback

# Secret utilisé pour signer le cookie de session (HMAC) — une chaîne
# aléatoire longue, ex: `openssl rand -hex 32`.
SESSION_SECRET=

# Base de données. En développement local (pnpm dev), pointe vers ton
# Postgres local. En Docker Compose, cette valeur est ignorée et remplacée
# automatiquement par la variable DATABASE_URL définie dans docker-compose.yml
# (qui pointe vers le service `postgres`) — inutile de la modifier pour un
# déploiement Docker.
DATABASE_URL=postgresql://user:password@localhost:5432/discord_dashboard

# URL publique du dashboard (utilisée pour construire des liens absolus,
# ex: les images de bannière envoyées par le bot).
NEXT_PUBLIC_APP_URL=https://ton-domaine.example
NODE_ENV=development

# --- Docker Compose uniquement (service postgres + nginx) ---
POSTGRES_DB=discord_dashboard
POSTGRES_USER=discord_dashboard
POSTGRES_PASSWORD=change-moi
NGINX_PORT=80
