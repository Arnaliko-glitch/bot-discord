# Discord Bot Dashboard - Variables d'environnement
# Copiez ce fichier vers .env et remplissez les valeurs

# ─── Discord Application ───────────────────────────────────────────
# Créez une application sur https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_BOT_TOKEN=your_bot_token

# URL de redirection OAuth2 (doit correspondre au portail Discord)
# Dev local: http://localhost:3000/api/auth/callback
# Production: https://votre-domaine.com/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ─── Session / Sécurité ────────────────────────────────────────────
# Chaîne aléatoire d'au moins 32 caractères (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-32-char-string-minimum

# ─── Base de données PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_bot_dashboard?schema=public

# ─── Application Web ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Optionnel ─────────────────────────────────────────────────────
# ID d'un serveur Discord pour le seed de démo
DEMO_GUILD_ID=000000000000000000

# Port Nginx (production Docker)
NGINX_PORT=80
